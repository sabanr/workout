@* Flickering flame; the flicker is disabled by prefers-reduced-motion in app.css. *@
<svg class="flame-flicker @Class" width="@Width" height="@(Width * 28 / 24)" viewBox="0 0 24 28" aria-hidden="true">
    <path d="M12 1c1 5 7 8 7 15a7 7 0 0 1-14 0c0-3 1.5-5 3-6.5C8.5 12 10 12.5 10 12.5 9 8 11 4 12 1z"
          fill="var(--forge-ember)" />
    <path d="M12 14c1 2.5 3.5 3.5 3.5 6a3.5 3.5 0 0 1-7 0c0-2 1.5-3 2-4 .5.8 1 1 1.5 1-.2-1 0-2 0-3z"
          fill="var(--forge-hot)" />
</svg>

@code {
    /// <summary>Rendered width in pixels (height keeps the 24:28 ratio).</summary>
    [Parameter]
    public int Width { get; set; } = 30;

    /// <summary>Extra CSS classes for the svg.</summary>
    [Parameter]
    public string? Class { get; set; }
}
