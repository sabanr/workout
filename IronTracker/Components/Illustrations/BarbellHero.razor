@* Barbell with ember plates and floating sparks. Scales to its container width. *@
<svg class="barbell-hero @Class" viewBox="0 0 380 148" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
    <rect x="10" y="72" width="360" height="6" rx="3" fill="#5b5b63" />
    <rect x="10" y="72" width="360" height="2" fill="#8d8d96" />
    <g>
        <rect x="48" y="42" width="14" height="66" rx="3" fill="#3a3a40" />
        <rect x="64" y="30" width="18" height="90" rx="4" fill="var(--forge-ember)" />
        <rect x="64" y="30" width="18" height="10" rx="4" fill="var(--forge-hot)" opacity=".6" />
        <rect x="84" y="38" width="14" height="74" rx="3" fill="#2a2a2f" />
        <rect x="100" y="64" width="8" height="22" rx="2" fill="#8d8d96" />
    </g>
    <g>
        <rect x="318" y="42" width="14" height="66" rx="3" fill="#3a3a40" />
        <rect x="298" y="30" width="18" height="90" rx="4" fill="var(--forge-ember)" />
        <rect x="298" y="30" width="18" height="10" rx="4" fill="var(--forge-hot)" opacity=".6" />
        <rect x="282" y="38" width="14" height="74" rx="3" fill="#2a2a2f" />
        <rect x="272" y="64" width="8" height="22" rx="2" fill="#8d8d96" />
    </g>
    @if (Sparks)
    {
        <circle class="spark" style="--dx:10px;animation-delay:0s" cx="72" cy="28" r="2.2" fill="var(--forge-hot)" />
        <circle class="spark" style="--dx:-8px;animation-delay:.9s" cx="306" cy="28" r="1.8"
                fill="var(--forge-ember)" />
        <circle class="spark" style="--dx:14px;animation-delay:1.7s" cx="190" cy="70" r="1.6"
                fill="var(--forge-hot)" />
        <circle class="spark" style="--dx:-12px;animation-delay:2.3s" cx="90" cy="34" r="1.5"
                fill="var(--forge-ember)" />
        <circle class="spark" style="--dx:6px;animation-delay:1.2s" cx="320" cy="34" r="2" fill="var(--forge-hot)" />
        <circle class="spark" style="--dx:-6px;animation-delay:2.7s" cx="240" cy="70" r="1.4" fill="var(--forge-hot)" />
    }
</svg>

@code {
    /// <summary>Extra CSS classes (e.g. to position or size the illustration).</summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>Show the animated sparks rising from the bar.</summary>
    [Parameter]
    public bool Sparks { get; set; } = true;
}
