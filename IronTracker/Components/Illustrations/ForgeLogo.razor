@* Anvil logo mark on an ember tile. Size is the tile edge in px. *@
<div class="forge-logo @Class" style="width:@(Size)px;height:@(Size)px;" aria-hidden="true">
    <svg width="@(Size * 5 / 8)" height="@(Size * 5 / 8)" viewBox="0 0 24 24" fill="none" stroke="#0F0F10"
         stroke-width="2" stroke-linejoin="round" stroke-linecap="round">
        <path d="M3 7h13a4 4 0 0 1-4 4v2c0 1 1 2 2 3v2H7v-2c1-1 2-2 2-3v-2H6a3 3 0 0 1-3-4z" />
    </svg>
</div>

@code {
    /// <summary>Tile edge length in pixels.</summary>
    [Parameter]
    public int Size { get; set; } = 38;

    /// <summary>Extra CSS classes for the tile.</summary>
    [Parameter]
    public string? Class { get; set; }
}
