@page "/"
@using IronTracker.Models
@using IronTracker.Services
@using IronTracker.Services.Interfaces
@inject WorkoutService WorkoutService
@inject SettingsService SettingsService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject IStringLocalizer<AppResources> L
@implements IDisposable

<PageTitle>@L["Dashboard"] - IronTracker</PageTitle>

<div class="d-flex justify-space-between align-center mb-4">
    <h1 class="forge-display forge-page-title">@L["Dashboard"]</h1>
    <MudIconButton Icon="@Icons.Material.Rounded.Settings"
                   Size="Size.Medium"
                   Class="home-settings-btn"
                   OnClick="OpenDashboardSettings"
                   Title="@L["DashboardSettings"]" />
</div>

@if (_loading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else
{
    @* Quick Start hero *@
    @if (SettingsService.ShowQuickStartCard)
    {
        <section class="forge-card forge-hero-bg home-hero forge-rise stagger-1">
            <div class="home-hero-text">
                <span class="forge-stat-label home-hero-kicker">
                    @(_hasActiveSession ? L["SessionActive"] : L["ReadyToTrain"])
                </span>
                <button type="button" class="forge-btn-ember home-hero-btn"
                        @onclick="@(() => Navigation.NavigateTo("/session"))">
                    <MudIcon Icon="@Icons.Material.Rounded.PlayArrow" />
                    @(_hasActiveSession ? L["ContinueWorkout"] : L["StartWorkout"])
                </button>
            </div>
            <BarbellHero Class="home-hero-art" />
        </section>
    }

    @* Rolling stats (last 30 days) *@
    <section class="home-stats">
        @if (SettingsService.ShowStreakCard)
        {
            <StatTile Label="@L["DaysStreakLabel"]" Value="@_stats!.ConsecutiveDaysStreak.ToString()" Stagger="2">
                <Visual>
                    @if (_stats!.ConsecutiveDaysStreak > 0)
                    {
                        <FlameIcon Width="28" />
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Rounded.LocalFireDepartment" Class="forge-muted" />
                    }
                </Visual>
            </StatTile>
        }

        @if (SettingsService.ShowWorkoutsCard)
        {
            <StatTile Label="@($"{L["Workouts"]} (30d)")" Value="@_stats!.WorkoutsThisMonth.ToString()" Stagger="3" />
        }

        @if (SettingsService.ShowVolumeCard)
        {
            <StatTile Label="@($"{L["Volume"]} (30d)")" Value="@FormatVolume(_stats!.VolumeThisMonth)" Stagger="4" />
        }

        @if (SettingsService.ShowAvgDurationCard)
        {
            <StatTile Label="@($"{L["AvgDuration"]} (30d)")" Value="@FormatDurationShort(_stats!.AverageDuration)"
                      Stagger="5" />
        }

        @if (SettingsService.ShowFavoriteRoutineCard)
        {
            <StatTile Label="@($"{L["Favorite"]} (30d)")" Value="@(_stats!.FavoriteRoutineName ?? "-")"
                      Compact="true" Stagger="6" />
        }

        @if (SettingsService.ShowFrequencyCard)
        {
            <StatTile Label="@($"{L["Consistency"]} (30d)")" Value="@($"{_stats!.TrainingFrequency:F0}%")" Stagger="7">
                <Visual>
                    <svg class="home-gauge" viewBox="0 0 36 36" aria-hidden="true">
                        <circle class="home-gauge-track" cx="18" cy="18" r="15.9" />
                        <circle class="home-gauge-fill" cx="18" cy="18" r="15.9" pathLength="100"
                                stroke-dasharray="@GetGaugeDash()" />
                    </svg>
                </Visual>
            </StatTile>
        }
    </section>

    <MudGrid>
        @* Weekly Volume Chart (Last 3 Months) *@
        @if (SettingsService.ShowVolumeChart)
        {
            <MudItem xs="12" md="@(SettingsService.ShowRecentActivity || SettingsService.ShowPersonalRecordsCard ? 8 : 12)">
                <MudCard Elevation="0" Class="forge-card forge-card-static forge-rise stagger-4">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <h2 class="forge-section-title mb-0">
                                @L["WeeklyTrainingVolume", SettingsService.GetUnitAbbreviation()]
                            </h2>
                            @if (!string.IsNullOrEmpty(_chartSubtitle))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@_chartSubtitle</MudText>
                            }
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Class="forge-chart">
                        @if (_chartLabels.Length > 0)
                        {
                            <MudChart ChartType="ChartType.Bar"
                                      ChartSeries="_chartSeries"
                                      XAxisLabels="_chartLabels"
                                      Width="100%"
                                      Height="300px"
                                      ChartOptions="_chartOptions" />
                        }
                        else
                        {
                            <MudText Color="Color.Secondary" Class="text-center pa-8">
                                @L["NoWorkoutDataYet"]
                            </MudText>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }

        @* Lists stack in a right column beside the chart, or sit side by side when the chart is hidden *@
        @if (SettingsService.ShowRecentActivity || SettingsService.ShowPersonalRecordsCard)
        {
        <MudItem xs="12" md="@(SettingsService.ShowVolumeChart ? 4 : 12)">
        <div class="home-side @(SettingsService.ShowVolumeChart ? "home-side-stacked" : "home-side-split")">
        @* Recent Sessions *@
        @if (SettingsService.ShowRecentActivity)
        {
            <div>
                <MudCard Elevation="0" Class="forge-card forge-card-static forge-rise stagger-5">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <h2 class="forge-section-title mb-0">@L["RecentActivity"]</h2>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Style="max-height: 340px; overflow-y: auto;">
                        @if (_stats!.RecentSessions.Count > 0)
                        {
                            <MudList T="WorkoutSession" Dense="true" Class="home-list">
                                @foreach (var session in _stats.RecentSessions)
                                {
                                    <MudListItem Icon="@Icons.Material.Rounded.FitnessCenter" IconColor="Color.Primary">
                                        <div class="d-flex flex-column">
                                            <MudText Typo="Typo.body2">@session.RoutineDay?.Name</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                @session.StartTime.ToLocalTime().ToString("ddd, MMM d") -
                                                @FormatDuration(session.Duration)
                                            </MudText>
                                        </div>
                                    </MudListItem>
                                }
                            </MudList>
                        }
                        else
                        {
                            <MudText Color="Color.Secondary" Class="text-center pa-4">
                                @L["NoSessionsYet"]
                            </MudText>
                        }
                    </MudCardContent>
                </MudCard>
            </div>
        }

        @* Personal Records *@
        @if (SettingsService.ShowPersonalRecordsCard)
        {
            <div>
                <MudCard Elevation="0" Class="forge-card forge-card-static forge-rise stagger-6">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <h2 class="forge-section-title mb-0">@L["PersonalRecords"]</h2>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent Style="max-height: 340px; overflow-y: auto;">
                        @if (_stats!.TopPersonalRecords.Count > 0)
                        {
                            <MudList T="PersonalRecord" Dense="true" Class="home-list">
                                @foreach (var pr in _stats.TopPersonalRecords)
                                {
                                    <MudListItem Icon="@Icons.Material.Rounded.EmojiEvents" IconColor="Color.Secondary"
                                                 Class="forge-shimmer">
                                        <div class="d-flex flex-column" Style="width: 100%;">
                                            <MudText Typo="Typo.body2">@pr.ExerciseName</MudText>
                                            <div class="d-flex justify-space-between">
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    @($"{pr.MaxWeight:F1}") @SettingsService.GetUnitAbbreviation()
                                                </MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    @pr.AchievedAt.ToLocalTime().ToString("MMM d, yyyy")
                                                </MudText>
                                            </div>
                                        </div>
                                    </MudListItem>
                                }
                            </MudList>
                        }
                        else
                        {
                            <MudText Color="Color.Secondary" Class="text-center pa-4">
                                @L["NoDataYet"]
                            </MudText>
                        }
                    </MudCardContent>
                </MudCard>
            </div>
        }
        </div>
        </MudItem>
        }
    </MudGrid>
}

@code {
    private bool _loading = true;
    private bool _hasActiveSession;
    private DashboardStats? _stats;
    private List<ChartSeries> _chartSeries = new();
    private string[] _chartLabels = Array.Empty<string>();
    private string _chartSubtitle = string.Empty;
    // Y-axis step is recalculated from the data in PrepareChartData. The palette points at the theme's primary
    // (ember) so the bars follow the light/dark palette.
    private ChartOptions _chartOptions = new() { YAxisTicks = 5, ChartPalette = ["var(--mud-palette-primary)"] };

    protected override async Task OnInitializedAsync()
    {
        SettingsService.WeightUnitChanged += OnWeightUnitChanged;
        SettingsService.DashboardVisibilityChanged += OnDashboardVisibilityChanged;

        _loading = true;

        _hasActiveSession = await WorkoutService.HasActiveSessionAsync();
        _stats = await WorkoutService.GetDashboardStatsAsync();

        PrepareChartData();

        _loading = false;
    }

    private void OnWeightUnitChanged()
    {
        PrepareChartData();
        InvokeAsync(StateHasChanged);
    }

    private void OnDashboardVisibilityChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task OpenDashboardSettings()
    {
        await DialogService.ShowAsync<DashboardSettingsDialog>(L["DashboardSettings"].Value);
    }

    private void PrepareChartData()
    {
        _chartSeries = new List<ChartSeries>();
        _chartLabels = Array.Empty<string>();
        _chartSubtitle = string.Empty;

        if (_stats?.WeeklyVolume == null || _stats.WeeklyVolume.Count == 0)
            return;

        var orderedData = _stats.WeeklyVolume
            .OrderBy(kv => kv.Key)
            .ToList();

        var values = orderedData
            .Select(kv => (double)SettingsService.ConvertToDisplayUnit(kv.Value))
            .ToArray();

        // Every week in the window is present (rest weeks are 0), so an all-zero series means no data.
        if (values.All(v => v <= 0))
            return;

        // Sparse x-axis labels: a date on roughly every fourth bar keeps the axis readable. The
        // remaining labels are empty strings so the array length still drives bar spacing.
        _chartLabels = BuildSparseLabels(orderedData.Select(kv => kv.Key).ToList());

        _chartSubtitle = L["WeeklyVolumeSubtitle"];

        var maxValue = values.Max();

        // Y-axis step: aim for ~5 gridlines landing on round numbers.
        _chartOptions.YAxisTicks = CalculateYAxisStep(maxValue);

        // Format string syntax: each comma divides by 1,000
        // e.g., "0,K" divides by 1,000 and adds "K"
        // e.g., "0,,.##M" divides by 1,000,000 and adds "M" with up to 2 decimals
        if (maxValue >= 1_000_000)
        {
            _chartOptions.YAxisFormat = "0,,.##M"; // e.g., "1.25M"
        }
        else if (maxValue >= 10_000)
        {
            _chartOptions.YAxisFormat = "0,K"; // e.g., "15K"
        }
        else if (maxValue >= 1_000)
        {
            _chartOptions.YAxisFormat = "0,.##K"; // e.g., "1.5K", "5K"
        }
        else
        {
            _chartOptions.YAxisFormat = "0"; // e.g., "500"
        }

        _chartSeries = new List<ChartSeries>
        {
            new ChartSeries
            {
                Name = L["Volume"],
                Data = values
            }
        };
    }

    /// <summary>
    /// Builds one label per bar, but only fills in about four of them (anchored on the most recent
    /// week) so the dates stay readable instead of overlapping.
    /// </summary>
    private static string[] BuildSparseLabels(IReadOnlyList<DateTime> weekStarts)
    {
        const int targetLabelCount = 4;

        var step = Math.Max(1, (int)Math.Ceiling(weekStarts.Count / (double)targetLabelCount));
        var labels = new string[weekStarts.Count];
        var lastIndex = weekStarts.Count - 1;

        for (var i = 0; i < weekStarts.Count; i++)
        {
            labels[i] = (lastIndex - i) % step == 0
                ? weekStarts[i].ToString("MMM d")
                : string.Empty;
        }

        return labels;
    }

    /// <summary>
    /// Picks a round Y-axis step (1, 2 or 5 x a power of ten) so roughly five gridlines cover the data.
    /// </summary>
    private static int CalculateYAxisStep(double maxValue)
    {
        if (maxValue <= 0)
            return 1;

        var rawStep = maxValue / 5.0;
        var magnitude = Math.Pow(10, Math.Floor(Math.Log10(rawStep)));
        var normalized = rawStep / magnitude;

        var niceStep = normalized switch
        {
            <= 1 => 1,
            <= 2 => 2,
            <= 5 => 5,
            _ => 10
        };

        return Math.Max(1, (int)(niceStep * magnitude));
    }

    private string FormatDuration(TimeSpan? duration)
    {
        if (!duration.HasValue)
            return L["InProgress"];

        if (duration.Value.TotalHours >= 1)
            return $"{duration.Value.Hours}h {duration.Value.Minutes}m";

        return $"{duration.Value.Minutes}m";
    }

    private string FormatVolume(decimal volume)
    {
        var displayVolume = SettingsService.ConvertToDisplayUnit(volume);
        var unit = SettingsService.GetUnitAbbreviation();

        if (displayVolume >= 1_000_000)
            return $"{(displayVolume / 1_000_000):F1}M {unit}";
        if (displayVolume >= 1_000)
            return $"{(displayVolume / 1_000):F1}K {unit}";

        return $"{displayVolume:F0} {unit}";
    }

    private string FormatDurationShort(TimeSpan duration)
    {
        if (duration.TotalMinutes < 1)
            return "-";

        return $"{Math.Round(duration.TotalMinutes)}m";
    }

    // Dash pattern for the consistency gauge: the ring has pathLength 100, so the filled arc is the percentage.
    private string GetGaugeDash()
    {
        var percent = Math.Clamp(_stats!.TrainingFrequency, 0, 100);
        return FormattableString.Invariant($"{percent:F1} 100");
    }

    public void Dispose()
    {
        SettingsService.WeightUnitChanged -= OnWeightUnitChanged;
        SettingsService.DashboardVisibilityChanged -= OnDashboardVisibilityChanged;
    }
}
