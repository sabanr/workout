@inherits LayoutComponentBase
@inject SettingsService SettingsService
@inject IStringLocalizer<AppResources> L

@* Theme class lives on a wrapper that also contains the providers, so popovers and dialogs inherit the tokens *@
<div class="forge-root @(_isDarkMode ? "" : "forge-light")">
    <MudThemeProvider @ref="_themeProvider" Theme="@ForgeTheme.Theme" @bind-IsDarkMode="@_isDarkMode" />
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />

    <MudLayout>
        <MudAppBar Elevation="0" Class="forge-appbar">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                           OnClick="@ToggleDrawer" />
            <ForgeLogo Size="30" Class="ml-3" />
            <span class="forge-wordmark ml-2">Iron<span>Tracker</span></span>
        </MudAppBar>

        <MudDrawer @bind-Open="_drawerOpen" Elevation="0" Variant="@DrawerVariant.Responsive"
                   ClipMode="DrawerClipMode.Always" Class="forge-drawer">
            <div class="forge-drawer-inner">
                <NavMenu />
                <div class="forge-drawer-spacer"></div>
                <div class="forge-drawer-footer">
                    <div class="forge-segmented" role="group" aria-label="@L["ToggleLanguage"]">
                        <button type="button" aria-pressed="@(!IsSpanish)" class="@SegClass(!IsSpanish)"
                                @onclick="@(() => SetLanguage(false))">EN</button>
                        <button type="button" aria-pressed="@IsSpanish" class="@SegClass(IsSpanish)"
                                @onclick="@(() => SetLanguage(true))">ES</button>
                    </div>
                    <div class="forge-segmented" role="group" aria-label="@L["Weight"]">
                        <button type="button" aria-pressed="@(!IsLbs)" class="@SegClass(!IsLbs)"
                                @onclick="@(() => SetWeightUnit(false))">kg</button>
                        <button type="button" aria-pressed="@IsLbs" class="@SegClass(IsLbs)"
                                @onclick="@(() => SetWeightUnit(true))">lbs</button>
                    </div>
                    <button type="button" class="forge-theme-btn" @onclick="@ToggleDarkMode"
                            aria-label="@(_isDarkMode ? L["LightMode"] : L["DarkMode"])">
                        <MudIcon Icon="@(_isDarkMode
                                    ? Icons.Material.Filled.LightMode
                                    : Icons.Material.Filled.DarkMode)"
                                 Size="Size.Small" />
                    </button>
                    <div class="forge-version">@($"v{GetAppVersion()}")</div>
                </div>
            </div>
        </MudDrawer>

        <MudMainContent Class="pt-16 px-4">
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4">
                <div>
                    @Body
                </div>
            </MudContainer>
        </MudMainContent>
    </MudLayout>
</div>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode;
    private MudThemeProvider _themeProvider = null!;

    private bool IsLbs => SettingsService.WeightUnit == Models.WeightUnit.Lbs;

    private bool IsSpanish => string.Equals(
        SettingsService.LanguageCode, SettingsService.SpanishArgentinaLanguageCode, StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        _isDarkMode = SettingsService.IsDarkMode;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!Preferences.ContainsKey("IsDarkMode"))
            {
                _isDarkMode = await _themeProvider.GetSystemPreference();
                SettingsService.IsDarkMode = _isDarkMode;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private void ToggleDarkMode()
    {
        _isDarkMode = !_isDarkMode;
        SettingsService.IsDarkMode = _isDarkMode;
    }

    private void ToggleWeightUnit()
    {
        SettingsService.ToggleWeightUnit();
        StateHasChanged();
    }

    private void ToggleLanguage()
    {
        SettingsService.ToggleLanguage();
        // Reload the native WebView to apply the new culture
        // NavigationManager.forceLoad doesn't work for culture changes in MAUI Blazor
        var mainPage = Application.Current?.MainPage as MainPage;
        mainPage?.ReloadWebView();
    }

    private static string SegClass(bool active)
    {
        return active ? "active" : string.Empty;
    }

    private void SetWeightUnit(bool lbs)
    {
        if (lbs != IsLbs)
        {
            ToggleWeightUnit();
        }
    }

    private void SetLanguage(bool spanish)
    {
        if (spanish != IsSpanish)
        {
            ToggleLanguage();
        }
    }

    private string GetAppVersion()
    {
        var version = typeof(MainLayout).Assembly.GetName().Version;
        return version != null ? $"{version.Major}.{version.Minor}.{version.Build}" : AppInfo.VersionString;
    }
}
